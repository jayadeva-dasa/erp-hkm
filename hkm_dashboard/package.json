{
    "name": "hkm-dashboard",
    "version": "1.0.0",
    "description": "HKM Jaipur Unified Dashboard - Single Page App",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && yarn copy-html-entry",
        "preview": "vite preview",
        "copy-html-entry": "cp ../hkm/public/hkm-dashboard/index.html ../hkm/www/hkm-dashboard.html && sed -i 's|<div id=\"root\"></div>|<div id=\"root\"></div>\\n    <script>window.csrf_token = '\"'\"'{{ frappe.session.csrf_token }}'\"'\"';</script>|' ../hkm/www/hkm-dashboard.html"
    },
    "dependencies": {
        "@chakra-ui/icons": "^2.1.1",
        "@chakra-ui/react": "^2.8.2",
        "@emotion/react": "^11.11.4",
        "@emotion/styled": "^11.11.5",
        "@mui/icons-material": "^7.2.0",
        "@mui/material": "^7.2.0",
        "axios": "^1.6.8",
        "date-fns": "^3.6.0",
        "dayjs": "^1.11.13",
        "echarts": "^5.4.3",
        "echarts-for-react": "^3.0.2",
        "framer-motion": "^11.1.7",
        "jspdf": "^2.5.1",
        "jspdf-autotable": "^3.8.3",
        "react": "^18.3.1",
        "react-beautiful-dnd": "^13.1.1",
        "react-dom": "^18.3.1",
        "react-icons": "^5.2.1",
        "react-router-dom": "^6.23.0",
        "react-simple-maps": "^3.0.0",
        "recharts": "^2.12.6",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.2.1",
        "typescript": "^5.5.4",
        "vite": "^7.2.7"
    }
}
